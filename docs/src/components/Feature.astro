---
/**
 * One item in the landing page's benefit sections ("What can you do with
 * Nebari?" and "What you don't have to do"): an outline icon in a tinted tile,
 * then a heading, a sentence, and a link to the page that backs the claim.
 *
 * The layout is the parent's job. Inside `.nebari-bento` the item is a card in
 * a bento grid (`wide` makes it span two columns); inside `.nebari-skip` it is
 * a compact list item whose icon tile is struck through.
 *
 * Starlight's own icon set is filled and reads heavier than these sections
 * want, so the outline glyphs (Lucide, ISC) live here rather than coming from
 * `<Icon>`. Sized in `em` so they track the tile's font size.
 */
const icons = {
  cloud: '<path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>',
  rocket:
    '<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91 0z"/>' +
    '<path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>' +
    '<path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>',
  blocks:
    '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>' +
    '<rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 17.5h7M17.5 14v7"/>',
  branch: '<path d="M6 3v12"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/>',
  pulse: '<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  lock: '<rect x="3.5" y="11" width="17" height="10" rx="2"/><path d="M7.5 11V7a4.5 4.5 0 0 1 9 0v4"/>',
  chip:
    '<rect x="5" y="5" width="14" height="14" rx="2"/><rect x="9" y="9" width="6" height="6"/>' +
    '<path d="M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3"/>',
  database:
    '<ellipse cx="12" cy="5.5" rx="8" ry="3"/><path d="M4 5.5v13c0 1.66 3.58 3 8 3s8-1.34 8-3v-13"/>' +
    '<path d="M4 12c0 1.66 3.58 3 8 3s8-1.34 8-3"/>',
  layers: '<path d="m12 2 9 5-9 5-9-5 9-5Z"/><path d="m3 17 9 5 9-5"/><path d="m3 12 9 5 9-5"/>',
} as const;

interface Props {
  icon: keyof typeof icons;
  /** Span two columns of the bento grid. Ignored outside `.nebari-bento`. */
  wide?: boolean;
}

const { icon, wide = false } = Astro.props;
---

<div class:list={['nebari-feature', { 'nebari-feature--wide': wide }]}>
  <span class="nebari-feature__tile" aria-hidden="true">
    <svg
      class="nebari-feature__icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      set:html={icons[icon]}
    />
  </span>
  <div class="nebari-feature__text"><slot /></div>
</div>
