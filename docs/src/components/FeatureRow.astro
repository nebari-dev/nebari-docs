---
/**
 * One item in the landing page's "What can you do with Nebari?" list: an
 * outline icon on a tinted tile, then a heading on the same line, with a
 * sentence and a link to the page that backs the claim below them. Renders an
 * `<li>`, so place it inside the `<ul class="nebari-rows">`.
 */
import { icons, type IconName } from './icons';

interface Props {
  icon: IconName;
}

const { icon } = Astro.props;

// `pathLength="1"` lets the stroke-draw in custom.css use the same dash length
// for every shape, whatever its real length.
const glyph = icons[icon].replace(/<(path|circle|rect)\b/g, '<$1 pathLength="1"');
---

<li class="nebari-row" data-draw>
  <span class="nebari-row__icon" aria-hidden="true">
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      set:html={glyph}
    />
  </span>
  <slot />
</li>

