---
/**
 * Wraps the Nebari theme's `MarkdownContent`, which adds table scrolling and TOC tracking,
 * and prepends the Nebari Classic phase-out notice. Only the classic.nebari.dev build uses
 * this override, so the notice appears on every page there.
 */
import { Aside } from '@astrojs/starlight/components';
import ThemeContent from '@nebari/starlight/components/MarkdownContent.astro';
---

<ThemeContent>
  <Aside type="caution" title="Nebari Classic is in maintenance mode">
    <p>
      <strong>You're reading the Nebari Classic docs.</strong> For the current Nebari, go to the
      <a href="https://www.nebari.dev/docs/introduction/">Nebari documentation</a>.
    </p>
    <p>Nebari Classic still gets security updates and key bug fixes, expected through the end of 2026, but no new features.</p>
  </Aside>
  <slot />
</ThemeContent>
