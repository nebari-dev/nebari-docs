---
/**
 * The Nebari ecosystem: Software Packs (Capabilities) are published to
 * GitHub and installed onto a Deploy Target, an NKP cluster running on your
 * infrastructure. It always uses the light palette on a white card, in both
 * light and dark mode.
 */
---

<svg
  class="diagram"
  viewBox="-16 -16 848 324"
  width="100%"
  role="img"
  aria-label="The Nebari ecosystem: Software Packs, such as a chat assistant, a document analyzer, and code review, deliver Capabilities. They are published to GitHub, then installed onto a Deploy Target: an NKP cluster on your infrastructure, which runs the Capabilities."
>
  <title>The Nebari ecosystem</title>

  <text x="408" y="30" class="heading" text-anchor="middle">The Nebari Ecosystem</text>

  <!-- Software Packs -->
  <rect x="8" y="64" width="240" height="224" rx="14" class="group-packs" />
  <text x="128" y="96" class="eyebrow eyebrow-packs" text-anchor="middle">SOFTWARE PACKS</text>
  <rect x="24" y="112" width="208" height="38" rx="8" class="box-pack" />
  <text x="128" y="136" class="item" text-anchor="middle">Chat assistant</text>
  <rect x="24" y="158" width="208" height="38" rx="8" class="box-pack" />
  <text x="128" y="182" class="item" text-anchor="middle">Document analyzer</text>
  <rect x="24" y="204" width="208" height="38" rx="8" class="box-pack" />
  <text x="128" y="228" class="item" text-anchor="middle">Code review</text>
  <text x="128" y="270" class="caption" text-anchor="middle">Capabilities</text>

  <!-- publish -->
  <text x="296" y="164" class="sub" text-anchor="middle">publish</text>
  <line x1="262" y1="176" x2="330" y2="176" class="line" />
  <path d="M324 170 L330 176 L324 182" class="arrowhead" />

  <!-- GitHub -->
  <rect x="340" y="154" width="136" height="44" rx="22" class="box-github" />
  <path
    transform="translate(362 166) scale(1.25)"
    class="github-mark"
    d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
  />
  <text x="392" y="182" class="github">GitHub</text>

  <!-- install -->
  <text x="520" y="164" class="sub" text-anchor="middle">install</text>
  <line x1="486" y1="176" x2="554" y2="176" class="line" />
  <path d="M548 170 L554 176 L548 182" class="arrowhead" />

  <!-- Deploy Targets -->
  <rect x="564" y="82" width="244" height="188" rx="14" class="group-targets" />
  <text x="686" y="114" class="eyebrow eyebrow-targets" text-anchor="middle">DEPLOY TARGETS</text>
  <rect x="584" y="132" width="204" height="78" rx="10" class="box-target" />
  <text x="686" y="166" class="title" text-anchor="middle">NKP cluster</text>
  <text x="686" y="192" class="sub" text-anchor="middle">on your infrastructure</text>
  <text x="686" y="244" class="caption" text-anchor="middle">running Capabilities</text>
</svg>

<style>
  .diagram {
    display: block;
    height: auto;
    margin-block: 1.5rem;
    font-family: var(--sl-font);
    background: #ffffff;
    border-radius: 12px;
  }
  .group-packs {
    fill: none;
    stroke: #2c817a;
    stroke-width: 1.5;
    stroke-dasharray: 5 4;
  }
  .group-targets {
    fill: none;
    stroke: #8e6c03;
    stroke-width: 1.5;
    stroke-dasharray: 5 4;
  }
  .box-pack {
    fill: #d1f8f3;
    stroke: #2c817a;
    stroke-width: 1.5;
  }
  .box-target {
    fill: #fcedcc;
    stroke: #8e6c03;
    stroke-width: 1.5;
  }
  .box-github {
    fill: #f4f4f5;
    stroke: #70707a;
    stroke-width: 1.5;
  }
  .github-mark {
    fill: #262628;
  }
  .heading {
    fill: #262628;
    font-size: 24px;
    font-weight: 700;
  }
  .eyebrow {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .eyebrow-packs {
    fill: #2c817a;
  }
  .eyebrow-targets {
    fill: #8e6c03;
  }
  .item {
    fill: #262628;
    font-size: 16px;
  }
  .title {
    fill: #262628;
    font-size: 18px;
    font-weight: 600;
  }
  .github {
    fill: #262628;
    font-size: 17px;
    font-weight: 600;
  }
  .sub {
    fill: #70707a;
    font-size: 15px;
  }
  .caption {
    fill: #70707a;
    font-size: 15px;
    font-style: italic;
  }
  .line {
    stroke: #70707a;
    stroke-width: 1.5;
  }
  .arrowhead {
    fill: none;
    stroke: #70707a;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
